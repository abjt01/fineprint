# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# More keys, comma-separated, to rotate through: each key gets its own per-minute budget, a key that
# hits a rate limit rests while the others carry on, and a rejected key drops out. `npm run keys` checks them.
# GROQ_API_KEYS=

# Models (all open-weight, served by Groq by default)
# READ_MODEL=openai/gpt-oss-120b      # money clauses and questions
# READ_MODEL_SMALL=openai/gpt-oss-20b # terms, fact-checks and money-day messages
# AUDIT_MODEL=qwen/qwen3.8-27b        # second opinion on every verified quote

# TEE mode (optional): read documents with gpt-oss-120b inside a hardware enclave.
# Tinfoil is free to start (no card): https://tinfoil.sh -> Dashboard -> API keys.
# The SDK checks the enclave's attestation against Tinfoil's published code before sending anything.
# TINFOIL_API_KEY=

# Or a provider that signs each reply (RedPill / Phala style: /signature/{id} and /attestation/report)
# TEE_BASE_URL=https://api.redpill.ai/v1
# TEE_API_KEY=
# TEE_MODEL=openai/gpt-oss-120b

# Any other OpenAI-compatible server instead of Groq (Ollama, vLLM, llama.cpp)
# LLM_BASE_URL=http://localhost:11434/v1
