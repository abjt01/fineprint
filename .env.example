# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Models (all open-weight, served by Groq by default)
# READ_MODEL=openai/gpt-oss-120b      # money clauses
# READ_MODEL_SMALL=openai/gpt-oss-20b # terms and house rules
# AUDIT_MODEL=qwen/qwen3.8-27b        # second opinion on every verified quote

# TEE mode: read agreements with an open model running in a GPU enclave. The provider must be
# OpenAI-compatible and expose /signature/{id} and /attestation/report (RedPill / Phala style).
# TEE_BASE_URL=https://api.redpill.ai/v1
# TEE_API_KEY=
# TEE_MODEL=openai/gpt-oss-120b

# Any other OpenAI-compatible server instead of Groq (Ollama, vLLM, llama.cpp)
# LLM_BASE_URL=http://localhost:11434/v1
